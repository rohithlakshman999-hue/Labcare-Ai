# LabCare AI - Backend Environment Configuration
PROJECT_NAME="LabCare AI"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./labcare.db"
SECRET_KEY="labcare-ai-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Monitoring Configuration
HEARTBEAT_TIMEOUT_SECONDS=90
OFFLINE_THRESHOLD_SECONDS=180
METRIC_COLLECTION_INTERVAL_SECONDS=15
DEMO_MODE=true

# Early Warning Thresholds
CPU_WARNING_THRESHOLD=80.0
CPU_SUSTAINED_MINUTES=3
RAM_WARNING_THRESHOLD=85.0
DISK_WARNING_THRESHOLD=90.0
FAILED_PING_THRESHOLD=3

# Optional LLM API Key (leave empty for deterministic RAG fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
